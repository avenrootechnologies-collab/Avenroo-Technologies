PORT=5000
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<db-name>?retryWrites=true&w=majority
CLIENT_URLS=http://localhost:5173,http://127.0.0.1:5173
ADMIN_APP_URL=http://localhost:5173
LOCAL_CONTACTS_FILE=./data/contacts.local.json
LOCAL_SERVICES_FILE=./data/services.local.json
NODE_ENV=development
LOG_LEVEL=debug
HEALTH_INCLUDE_DETAILS=false
ALLOW_PRODUCTION_LOCAL_CONTACT_STORAGE=false
CONTACT_BRAND_NAME=Avenroo Technologies
CONTACT_TO_EMAIL=connect@avenroo.in
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_AUTH=true
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM_NAME=Avenroo Technologies
SMTP_FROM_EMAIL=connect@avenroo.in
